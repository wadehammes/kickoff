{
  "name": "@wadehammes/kickoff",
  "version": "1.2.0",
  "description": "Generate a Next.js and TypeScript project with a handbook, agent hooks, and a review command that keep people and AI agents on the same conventions.",
  "keywords": [
    "nextjs",
    "scaffold",
    "cli",
    "handbook",
    "claude-code",
    "cursor",
    "ai-agents"
  ],
  "license": "MIT",
  "author": "Wade Hammes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wadehammes/kickoff.git"
  },
  "bugs": {
    "url": "https://github.com/wadehammes/kickoff/issues"
  },
  "homepage": "https://github.com/wadehammes/kickoff#readme",
  "type": "module",
  "bin": {
    "kickoff": "./dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "!dist/verifyScaffoldE2e.js",
    "scaffold-assets/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "biome check",
    "lint:ci": "biome ci --reporter=github",
    "lint:fix": "biome check --fix",
    "lint:check": "biome check --changed --since origin/main --no-errors-on-unmatched --verbose --write --diagnostic-level=error",
    "lint:all": "pnpm lint:check && pnpm tsc:ci",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:scaffold-e2e": "node dist/verifyScaffoldE2e.js",
    "test:watch": "vitest",
    "tsc:ci": "tsc --strict",
    "verify:package": "bash scripts/verify-package.sh"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "fs-extra": "^11.4.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.6",
    "@types/prompts": "^2.4.9",
    "@vitest/coverage-v8": "5.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
