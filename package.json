{
  "name": "kickoff",
  "version": "1.0.0",
  "packageManager": "pnpm@12.18.0",
  "description": "CLI scaffolding tool for Next.js + Contentful + TypeScript projects",
  "type": "module",
  "bin": {
    "kickoff": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "biome check",
    "lint:ci": "biome ci --reporter=github",
    "lint:fix": "biome check --fix",
    "lint:check": "biome check --changed --since origin/main --no-errors-on-unmatched --verbose --write --diagnostic-level=error",
    "lint:all": "pnpm lint:check && pnpm tsc:ci",
    "test": "vitest run",
    "test:scaffold-e2e": "node dist/verifyScaffoldE2e.js",
    "test:watch": "vitest",
    "tsc:ci": "tsc --strict"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "fs-extra": "^11.4.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.6",
    "@types/prompts": "^2.4.9",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
